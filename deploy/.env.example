DOMAIN=notes.example.org
ACME_EMAIL=you@example.org
# Versioned release image (or your own build, e.g. livemitschrift:0.2.0).
LIVEMITSCHRIFT_IMAGE=ghcr.io/andreaszsr/livemitschrift:0.2.0
# Optional HTTPS link to your privacy notice, shown in the browser viewer's menu.
PRIVACY_URL=
# Only for modified versions: HTTPS link to your source code (AGPL-3.0 section 13).
# Release images link to their upstream tag automatically.
SOURCE_URL=
# warning (default) writes no per-connection lines; use info only to diagnose.
LOG_LEVEL=warning
